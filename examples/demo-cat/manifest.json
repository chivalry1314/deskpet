{
  "name": "Demo Cat",
  "version": "1.0",
  "author": "DeskPet Engine",
  "window": {
    "width": 150,
    "height": 150,
    "scale": 1.0
  },
  "states": {
    "idle": {
      "frames": [
        "idle_01.png",
        "idle_02.png"
      ],
      "fps": 4,
      "loop": true
    },
    "clicked": {
      "frames": [
        "clicked_01.png",
        "clicked_02.png"
      ],
      "fps": 10,
      "loop": false,
      "next": "idle"
    }
  },
  "behavior": {
    "idle_time": [
      3,
      10
    ],
    "walk_speed": 2,
    "edge_bounce": true,
    "drag_physics": true
  },
  "interactions": {
    "on_click": "clicked",
    "on_drag": "idle",
    "on_hover": "idle"
  }
}